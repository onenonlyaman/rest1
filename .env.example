# Neon PostgreSQL Database Connection String
# Get your connection string from https://console.neon.tech
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional Admin PIN for accessing menu editor (default is none or 1234)
VITE_ADMIN_PIN=
